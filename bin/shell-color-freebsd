#!/bin/sh
# Native FreeBSD sh CLI: change next-prompt settings safely, never mutate caller PS1.
set -eu
dir=${SHELL_COLOR_CONFIG_DIR:-"$HOME/.config/shell-color"}
usage () { printf '%s\n' 'shell-color-freebsd --set 0..255 | --style compact|brackets|arrow|keep | --current | --help'; }
store () {
    [ ! -L "$dir" ] || { printf '%s\n' 'Symlinked configuration dir refused' >&2; exit 1; }
    mkdir -p "$dir"
    file=$dir/$1
    [ ! -L "$file" ] || { printf '%s\n' 'Symlinked configuration file refused' >&2; exit 1; }
    tmp=$file.$$
    (umask 077; printf '%s\n' "$2" > "$tmp") || exit 1
    mv -f "$tmp" "$file"
}
case ${1:---current} in
    --set)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        case $2 in ''|*[!0-9]*) usage >&2; exit 2 ;; esac
        [ "${#2}" -le 3 ] && [ "$2" -le 255 ] || { usage >&2; exit 2; }
        store color "$2"
        printf 'FreeBSD accent index: %s (applied in the next shell)\n' "$2"
        ;;
    --style)
        [ "$#" -eq 2 ] || { usage >&2; exit 2; }
        case $2 in compact|brackets|arrow|keep) ;; *) usage >&2; exit 2 ;; esac
        store ps1_style "$2"
        printf 'FreeBSD prompt style: %s (applied in the next shell)\n' "$2"
        ;;
    --current)
        idx=85; style=compact
        [ ! -r "$dir/color" ] || { IFS= read -r idx < "$dir/color" || :; }
        [ ! -r "$dir/ps1_style" ] || { IFS= read -r style < "$dir/ps1_style" || :; }
        printf 'FreeBSD prompt: color=%s style=%s\n' "$idx" "$style"
        ;;
    --help|-h) usage ;;
    *) usage >&2; exit 2 ;;
esac
